generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?   @unique
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  pets         Pet[]

  @@index([name])
  @@index([email])
  @@index([phone])
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId   String
  sitterId   String?
  operatorId String // who owns this booking

  clientLinkToken   String        @unique @default(cuid())
  notes             String?
  petDetails        Json?
  petNames          String[]      @default([])
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus @default(REQUESTED)
  clientTotalCents  Int
  platformFeeCents  Int
  sitterPayoutCents Int
  priceConfirmedAt  DateTime?
  canceledAt        DateTime?
  completedAt       DateTime?
  confirmedAt       DateTime?

  // -----------------------------
  // CANCELLATION FEE
  // -----------------------------
  cancellationFeeCents        Int       @default(0)
  cancellationFeeWaived       Boolean   @default(false)
  cancellationFeeRateBps      Int       @default(0)
  cancellationFeeReviewedAt   DateTime?
  cancellationFeeReviewedById String?
  cancellationFeeReviewedBy   User?     @relation("BookingCancellationFeeReviewedBy", fields: [cancellationFeeReviewedById], references: [id])

  serviceSummary String?

  // 🔹 optional service reference
  serviceId   String?
  service     Service?     @relation("BookingService", fields: [serviceId], references: [id])
  serviceType ServiceType?

  // -----------------------------
  // SERVICE LOCATION SNAPSHOT
  // -----------------------------
  serviceAddressLine1 String?
  serviceAddressLine2 String?
  serviceCity         String?
  serviceState        String?
  servicePostalCode   String?
  serviceCountry      String? @default("US")

  // -----------------------------
  // GEOCOORDINATES (future maps)
  // -----------------------------
  serviceLat Decimal? @db.Decimal(10, 7)
  serviceLng Decimal? @db.Decimal(10, 7)

  // -----------------------------
  // ARRIVAL / PROPERTY NOTES
  // -----------------------------
  accessInstructions String?
  locationNotes      String?

  client Client @relation(fields: [clientId], references: [id])

  // 🔹 OPERATOR + SITTER relations
  operator User  @relation("BookingOperator", fields: [operatorId], references: [id])
  sitter   User? @relation("BookingSitter", fields: [sitterId], references: [id])

  conversation Conversation?

  // 🔹 CHILD VISITS
  visits Visit[]

  history         BookingHistory[]
  lineItems       BookingLineItem[]
  bookingPets     BookingPet[]
  pricingSnapshot BookingPricingSnapshot?

  @@index([startTime])
  @@index([status, startTime])
  @@index([clientId, startTime])
  @@index([sitterId, startTime])
  @@index([operatorId, startTime])
  @@index([serviceLat, serviceLng])
  @@index([cancellationFeeReviewedById])
}

model Pet {
  id            String    @id @default(cuid())
  clientId      String
  name          String
  species       String
  imageUrl      String?
  imagePublicId String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  bookingPets BookingPet[]

  @@index([clientId, archivedAt])
}

model BookingPet {
  id              String   @id @default(cuid())
  bookingId       String
  petId           String?
  position        Int
  nameSnapshot    String
  speciesSnapshot String?
  createdAt       DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet     Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@unique([bookingId, position])
  @@index([bookingId])
  @@index([petId])
}

model BookingPricingSnapshot {
  id        String   @id @default(cuid())
  bookingId String   @unique
  createdAt DateTime @default(now())

  economicsVersion Int
  currency         String

  careOfferingId   String?
  careOfferingCode String
  careOfferingName String

  careOptionId    String?
  careOptionCode  String
  careOptionLabel String
  primarySpecies  String?

  billingUnit     CareBillingUnit
  scheduleKind    CareScheduleKind
  durationMinutes Int?

  quantity Int

  clientRateId      String?
  clientRateVersion Int

  serviceSubtotalCents Int
  clientFeeBasisPoints Int
  clientFeeCents       Int
  clientTotalCents     Int

  breakdown Json

  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  careOffering CareOffering?   @relation(fields: [careOfferingId], references: [id], onDelete: SetNull)
  careOption   CareOption?     @relation(fields: [careOptionId], references: [id], onDelete: SetNull)
  clientRate   ClientCareRate? @relation(fields: [clientRateId], references: [id], onDelete: SetNull)

  @@index([careOfferingId])
  @@index([careOptionId])
  @@index([clientRateId])
}

model BookingLineItem {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  bookingId       String
  label           String
  quantity        Int      @default(1)
  unitPriceCents  Int
  totalPriceCents Int
  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model Visit {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  operatorId String
  operator   User   @relation("VisitOperator", fields: [operatorId], references: [id])

  sitterId String?
  sitter   User?   @relation("VisitSitter", fields: [sitterId], references: [id])

  performedBySitterId String?
  performedBySitter   User?   @relation("VisitPerformedBySitter", fields: [performedBySitterId], references: [id], onDelete: Restrict)

  date      DateTime
  startTime DateTime
  endTime   DateTime

  status VisitStatus @default(CONFIRMED)

  @@index([bookingId])
  @@index([operatorId, date])
  @@index([sitterId, date])
  @@index([performedBySitterId])
  @@index([startTime, endTime])
}

model BookingHistory {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  bookingId       String
  changedByUserId String?
  fromStatus      BookingStatus?
  toStatus        BookingStatus?
  fromSitterId    String?
  toSitterId      String?
  note            String?

  // Missed visit review / accountability
  missedVisitReviewStatus String?
  missedVisitReviewedAt   DateTime?
  missedVisitReviewedById String?
  missedVisitReviewNote   String?

  booking   Booking @relation(fields: [bookingId], references: [id])
  changedBy User?   @relation("HistoryChangedBy", fields: [changedByUserId], references: [id])

  fromSitter User? @relation("HistoryFromSitter", fields: [fromSitterId], references: [id])
  toSitter   User? @relation("HistoryToSitter", fields: [toSitterId], references: [id])

  missedVisitReviewedBy User? @relation("MissedVisitReviewedBy", fields: [missedVisitReviewedById], references: [id])

  @@index([bookingId, createdAt])
  @@index([missedVisitReviewStatus])
  @@index([missedVisitReviewedById])
}

model BlockedClient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  reason   String?
  isActive Boolean @default(true)

  createdByUserId String?
  createdByUser   User?   @relation("BlockedClientCreatedBy", fields: [createdByUserId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([name])
  @@index([postalCode])
  @@index([isActive])
  @@index([createdByUserId])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  role               Role
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  emailVerified      DateTime?
  hashedPassword     String?
  mustChangePassword Boolean   @default(false)

  accounts Account[]
  sessions Session[]

  // 🔹 Bookings where this user is the SITTER
  sitterBookings Booking[] @relation("BookingSitter")

  // 🔹 Bookings where this user is the OPERATOR (Bridget)
  operatorBookings Booking[] @relation("BookingOperator")

  blockedClientsCreated BlockedClient[] @relation("BlockedClientCreatedBy")

  cancellationFeeReviews Booking[] @relation("BookingCancellationFeeReviewedBy")

  // 🔹 Visits where this user is the OPERATOR
  visitsAsOperator Visit[] @relation("VisitOperator")

  // 🔹 Visits where this user is the SITTER
  visitsAsSitter Visit[] @relation("VisitSitter")

  // Completed visits this sitter actually performed
  performedVisits Visit[] @relation("VisitPerformedBySitter")

  // History relations unchanged
  historyEntries    BookingHistory[] @relation("HistoryChangedBy")
  historyFromSitter BookingHistory[] @relation("HistoryFromSitter")
  historyToSitter   BookingHistory[] @relation("HistoryToSitter")

  // Missed visit review relations
  missedVisitReviews BookingHistory[] @relation("MissedVisitReviewedBy")

  sentMessages Message[] @relation("MessageSender")

  conversationParticipants ConversationParticipant[]

  clientCareRatesSet        ClientCareRate[]        @relation("ClientCareRateSetBy")
  defaultSitterCareRatesSet DefaultSitterCareRate[] @relation("DefaultSitterCareRateSetBy")
  sitterCareRates           SitterCareRate[]        @relation("SitterCareRates")
  sitterCareRatesSet        SitterCareRate[]        @relation("SitterCareRateSetBy")
}

model Conversation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  messages     Message[]
  participants ConversationParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId String?
  senderUser   User?   @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  senderType  MessageSenderType
  messageType MessageType       @default(TEXT)

  body String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([senderType])
}

model ConversationParticipant {
  id              String            @id @default(cuid())
  conversationId  String
  userId          String?
  participantType MessageSenderType
  participantKey  String
  lastReadAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([conversationId, participantKey])
  @@index([conversationId])
  @@index([userId])
  @@index([participantType])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id              String  @id @default(cuid())
  name            String
  code            String  @unique
  species         String
  category        String
  durationMinutes Int?
  basePriceCents  Int
  notes           String?
  isActive        Boolean @default(true)

  bookings      Booking[]             @relation("BookingService")
  addOns        ServiceAddOn[]
  legacyMapping LegacyServiceMapping?
}

model ServiceAddOn {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  priceCents  Int
  isActive    Boolean @default(true)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
}

model CareOffering {
  id                    String           @id @default(cuid())
  code                  String           @unique
  name                  String
  description           String?
  billingUnit           CareBillingUnit
  scheduleKind          CareScheduleKind
  allowsMixedSpecies    Boolean          @default(false)
  allowsUnlistedSpecies Boolean          @default(false)
  minimumPetCount       Int              @default(1)
  maximumPetCount       Int?
  isActive              Boolean          @default(true)
  sortOrder             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  options          CareOption[]
  speciesPolicies  CareSpeciesPolicy[]
  legacyMappings   LegacyServiceMapping[]
  pricingSnapshots BookingPricingSnapshot[]
}

model CareOption {
  id              String   @id @default(cuid())
  offeringId      String
  code            String   @unique
  label           String
  primarySpecies  String?
  durationMinutes Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offering CareOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  clientRate        ClientCareRate?
  defaultSitterRate DefaultSitterCareRate?
  sitterRates       SitterCareRate[]
  legacyMappings    LegacyServiceMapping[]
  pricingSnapshots  BookingPricingSnapshot[]

  @@index([offeringId, isActive])
}

model CareSpeciesPolicy {
  id           String  @id @default(cuid())
  offeringId   String
  species      String
  isSupported  Boolean @default(true)
  minimumCount Int     @default(0)
  maximumCount Int?

  offering CareOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, species])
  @@index([offeringId])
}

model ClientCareRate {
  id                     String   @id @default(cuid())
  careOptionId           String   @unique
  currency               String   @default("USD")
  baseRateCents          Int
  includedPetCount       Int      @default(1)
  defaultAdditionalCents Int?
  version                Int      @default(1)
  isActive               Boolean  @default(true)
  setByUserId            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  careOption       CareOption                @relation(fields: [careOptionId], references: [id], onDelete: Cascade)
  setByUser        User                      @relation("ClientCareRateSetBy", fields: [setByUserId], references: [id], onDelete: Restrict)
  petCharges       ClientCareRatePetCharge[]
  pricingSnapshots BookingPricingSnapshot[]

  @@index([setByUserId])
}

model ClientCareRatePetCharge {
  id              String @id @default(cuid())
  clientRateId    String
  species         String
  includedCount   Int    @default(0)
  additionalCents Int

  clientRate ClientCareRate @relation(fields: [clientRateId], references: [id], onDelete: Cascade)

  @@unique([clientRateId, species, includedCount])
  @@index([clientRateId])
}

model DefaultSitterCareRate {
  id                     String   @id @default(cuid())
  careOptionId           String   @unique
  currency               String   @default("USD")
  baseCompensationCents  Int
  includedPetCount       Int      @default(1)
  defaultAdditionalCents Int?
  version                Int      @default(1)
  isActive               Boolean  @default(true)
  setByUserId            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  careOption CareOption                       @relation(fields: [careOptionId], references: [id], onDelete: Cascade)
  setByUser  User                             @relation("DefaultSitterCareRateSetBy", fields: [setByUserId], references: [id], onDelete: Restrict)
  petCharges DefaultSitterCareRatePetCharge[]

  @@index([setByUserId])
}

model DefaultSitterCareRatePetCharge {
  id              String @id @default(cuid())
  defaultRateId   String
  species         String
  includedCount   Int    @default(0)
  additionalCents Int

  defaultRate DefaultSitterCareRate @relation(fields: [defaultRateId], references: [id], onDelete: Cascade)

  @@unique([defaultRateId, species, includedCount])
  @@index([defaultRateId])
}

model SitterCareRate {
  id                     String   @id @default(cuid())
  careOptionId           String
  sitterId               String
  currency               String   @default("USD")
  baseCompensationCents  Int
  includedPetCount       Int      @default(1)
  defaultAdditionalCents Int?
  version                Int      @default(1)
  isActive               Boolean  @default(true)
  setByUserId            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  careOption CareOption                @relation(fields: [careOptionId], references: [id], onDelete: Cascade)
  sitter     User                      @relation("SitterCareRates", fields: [sitterId], references: [id], onDelete: Cascade)
  setByUser  User                      @relation("SitterCareRateSetBy", fields: [setByUserId], references: [id], onDelete: Restrict)
  petCharges SitterCareRatePetCharge[]

  @@unique([careOptionId, sitterId])
  @@index([sitterId, isActive])
  @@index([setByUserId])
}

model SitterCareRatePetCharge {
  id              String @id @default(cuid())
  sitterRateId    String
  species         String
  includedCount   Int    @default(0)
  additionalCents Int

  sitterRate SitterCareRate @relation(fields: [sitterRateId], references: [id], onDelete: Cascade)

  @@unique([sitterRateId, species, includedCount])
  @@index([sitterRateId])
}

model LegacyServiceMapping {
  id              String  @id @default(cuid())
  legacyServiceId String  @unique
  offeringId      String
  optionId        String?
  notes           String?

  legacyService Service      @relation(fields: [legacyServiceId], references: [id], onDelete: Restrict)
  offering      CareOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  option        CareOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([offeringId])
  @@index([optionId])
}

enum Role {
  OPERATOR
  SITTER
}

enum CareBillingUnit {
  VISIT
  NIGHT
}

enum CareScheduleKind {
  TIMED_VISIT
  OVERNIGHT_STAY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum ServiceType {
  OVERNIGHT
  WALK
  DROP_IN
}

enum VisitStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

enum MessageSenderType {
  CLIENT
  SITTER
  OPERATOR
  SYSTEM
}

enum MessageType {
  TEXT
  SYSTEM
  ALERT
}
